---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
// Official app screenshot from bryramirezp/vox0, commit 5b4a6bc102c0708e0e1baecfc7b46155cf2b8121.
import vox0Screenshot from '../assets/vox0-screenshot.png';

const year = new Date().getFullYear();
const github = 'https://github.com/bryramirezp';
const linkedin = 'https://www.linkedin.com/in/bryramirezp/';
const experience = [
  {
    start: '2026-02',
    startLabel: 'Feb 2026',
    end: null,
    endLabel: 'Present',
    role: 'IT Assistant',
    company: 'andBeyond Travel',
    description: 'IT operations across lodges, yachts and destination management companies in South America.',
  },
  {
    start: '2024-10',
    startLabel: 'Oct 2024',
    end: '2025-05',
    endLabel: 'May 2025',
    role: 'IT Support',
    company: 'Servicio de Registro Civil e Identificación',
    description: 'Supported operational continuity for Chile’s civil registry service. Contracted through Entel.',
  },
];
---

<Layout>
  <div class="page-shell">
    <header class="site-header">
      <a class="wordmark" href="#" aria-label="barp.me — back to top">
        <span class="brand-square" aria-hidden="true"></span>
        barp.me
      </a>
      <nav aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#experience">Experience</a>
        <a class="nav-contact" href="#contact">Contact <Arrow direction="right" /></a>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <section class="hero" aria-labelledby="intro-heading">
        <p class="eyebrow hero-eyebrow">Bryan Ramírez <span aria-hidden="true">/</span> Chile</p>
        <div class="hero-title-row">
          <h1 id="intro-heading">IT by profession.<br />Builder by curiosity<span class="accent">.</span></h1>
          <svg class="asterisk" width="74" height="74" viewBox="0 0 80 80" fill="none" aria-hidden="true">
            <path d="M40 5v70M9.7 22.5l60.6 35M9.7 57.5l60.6-35" stroke="currentColor" stroke-width="9" />
          </svg>
        </div>
        <p class="hero-description">I keep systems running and build useful software.<br class="desktop-break" /> Currently at andBeyond Travel.</p>
        <div class="hero-actions">
          <a class="button" href="#work">Explore my work <Arrow direction="right" /></a>
          <a class="text-link" href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)">LinkedIn <Arrow /></a>
        </div>
      </section>

      <section class="work section" id="work" aria-labelledby="work-heading">
        <div class="section-heading">
          <h2 class="eyebrow" id="work-heading"><span class="section-number">01 /</span> Selected work</h2>
          <span class="eyebrow section-year">{year}</span>
        </div>

        <article class="project" aria-labelledby="vox0-heading">
          <div class="project-copy">
            <p class="eyebrow project-category">Personal project</p>
            <h3 id="vox0-heading">Vox0</h3>
            <p class="project-tagline">Your voice. Your words.</p>
            <p class="project-description">Free, open-source dictation for Windows. Hold a key, speak, and type into any app. Powered by Whisper, running locally on your computer.</p>
            <ul class="project-tags" aria-label="Vox0 features">
              <li>Windows</li>
              <li>Offline</li>
              <li>Open source</li>
            </ul>
            <div class="project-links">
              <a class="text-link" href="https://vox0.app/" target="_blank" rel="noopener noreferrer" aria-label="Visit project: Vox0 (opens in a new tab)">Visit project <Arrow /></a>
              <a class="text-link" href="https://github.com/bryramirezp/vox0" target="_blank" rel="noopener noreferrer" aria-label="Vox0 source on GitHub (opens in a new tab)">GitHub <Arrow /></a>
            </div>
          </div>
          <figure class="project-visual">
            <div class="screenshot-stage">
              <div class="visual-label eyebrow"><span>Vox0</span><span>Windows</span></div>
              <Image
                src={vox0Screenshot}
                alt="Vox0’s Windows app in dark mode, with its green ready indicator and a history of locally transcribed sentences."
                width={320}
                height={480}
                class="app-screenshot"
                loading="lazy"
                decoding="async"
                format="png"
              />
              <figcaption>Your voice stays on your computer.</figcaption>
            </div>
          </figure>
        </article>
      </section>

      <section class="experience section" id="experience" aria-labelledby="experience-heading">
        <div class="section-heading">
          <h2 class="eyebrow" id="experience-heading"><span class="section-number">02 /</span> Experience</h2>
        </div>
        <ol class="experience-list">
          {experience.map((job) => (
            <li class="experience-row">
              <p class="experience-dates eyebrow">
                <time datetime={job.start}>{job.startLabel}</time>
                <span aria-hidden="true">—</span>
                {job.end ? <time datetime={job.end}>{job.endLabel}</time> : <span>{job.endLabel}</span>}
              </p>
              <div class="experience-role">
                <h3>{job.role}</h3>
                <p lang={job.company.startsWith('Servicio') ? 'es' : undefined}>{job.company}</p>
              </div>
              <p class="experience-description">{job.description}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="contact section" id="contact" aria-labelledby="contact-heading">
        <p class="eyebrow"><span class="section-number">03 /</span> Contact</p>
        <div class="contact-row">
          <h2 id="contact-heading">Let’s connect<span class="accent">.</span></h2>
          <div class="contact-links">
            <a class="text-link" href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="Connect on LinkedIn (opens in a new tab)">LinkedIn <Arrow /></a>
            <a class="text-link" href={github} target="_blank" rel="noopener noreferrer" aria-label="Bryan Ramírez on GitHub (opens in a new tab)">GitHub <Arrow /></a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer eyebrow">
      <p>© {year} Bryan Ramírez</p>
      <a href="#" aria-label="barp.me — back to top">barp.me <Arrow direction="up-right" /></a>
    </footer>
  </div>
</Layout>
